rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Genel güvenlik kuralları
    function isSignedIn() {
      return request.auth != null;
    }

    // Test ve bağlantı denetimi
    match /test/{docId} {
      allow read, write: if true;
    }

    // Yemekler ve Kategoriler (Müşteriler için herkese açık okuma)
    match /yemekler/{yemekId} {
      allow read: if true;
      allow write: if true;
    }

    match /kategoriler/{kategoriId} {
      allow read: if true;
      allow write: if true;
    }

    match /alt_kategoriler/{altId} {
      allow read: if true;
      allow write: if true;
    }

    match /kampanyalar/{kampanyaId} {
      allow read: if true;
      allow write: if true;
    }

    match /gel_al_subeleri/{subeId} {
      allow read: if true;
      allow write: if true;
    }

    // Mutfaklar
    match /mutfaklar/{mutfakId} {
      allow read: if true;
      allow write: if true;
    }

    // Siparişler ve Ortak Sepet
    match /siparisler/{siparisId} {
      allow read, write: if true;
    }

    match /tamamlanan_siparisler/{siparisId} {
      allow read, write: if true;
    }

    match /sepet_elemanlari/{elemanId} {
      allow read, write: if true;
    }

    match /ortak_sepetler/{sepetId} {
      allow read, write: if true;
    }

    match /ortak_sepet_katilimcilari/{katilimciId} {
      allow read, write: if true;
    }

    match /ortak_sepet_elemanlari/{elemanId} {
      allow read, write: if true;
    }

    // Kurye ve Konum Takibi
    match /kurye_konumlari/{kuryeId} {
      allow read, write: if true;
    }

    // Kullanıcılar ve Adresler
    match /kullanicilar/{userId} {
      allow read, write: if true;
    }

    match /misafir_kullanicilar/{misafirId} {
      allow read, write: if true;
    }

    match /musteri_adresleri/{adresId} {
      allow read, write: if true;
    }

    // Ayarlar ve Bildirimler
    match /hakedis_talepleri/{talepId} {
      allow read, write: if true;
    }

    match /patron_bildirimleri/{bildirimId} {
      allow read, write: if true;
    }

    match /degerlendirmeler/{yorumId} {
      allow read, write: if true;
    }

    match /sozlesmeler/{sozlesmeId} {
      allow read, write: if true;
    }

    match /hukuki_onay_loglari/{logId} {
      allow read, write: if true;
    }

    match /reklam_ayarlari/{ayarId} {
      allow read, write: if true;
    }

    match /sistem_ayarlari/{ayarId} {
      allow read, write: if true;
    }

    match /genel_ayarlar/{ayarId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
