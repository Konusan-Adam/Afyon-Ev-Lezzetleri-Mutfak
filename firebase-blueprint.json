{
  "entities": {
    "Mutfak": {
      "title": "Mutfak",
      "description": "Ev mutfağı ve aşçı profili",
      "type": "object",
      "properties": {
        "kimlik": { "type": "string" },
        "isletme_adi": { "type": "string" },
        "mutfak_adi": { "type": "string" },
        "aciklama": { "type": "string", "maxLength": 180 },
        "hazirlanma_suresi": { "type": "string" },
        "calisma_saatleri": { "type": "string" },
        "mahalle": { "type": "string" },
        "acik_mi": { "type": "boolean" },
        "min_siparis_tutari": { "type": "number" },
        "mola_durumu": { "type": "boolean" },
        "mola_bitis_zamani": { "type": "string" },
        "calisma_modeli": { "type": "string" },
        "ilce": { "type": "string" },
        "adres": { "type": "string" },
        "onayli_mi": { "type": "boolean" },
        "onay_durumu": { "type": "string" },
        "askida_mi": { "type": "boolean" },
        "belgeler": { "type": "object" }
      }
    },
    "Yemek": {
      "title": "Yemek",
      "description": "Mutfak menü öğesi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "baslik": { "type": "string" },
        "fiyat": { "type": "number" },
        "birim": { "type": "string" },
        "mutfak_id": { "type": "string" },
        "gunluk_stok": { "type": "number" },
        "kalan_stok": { "type": "number" },
        "sinirsiz_stok": { "type": "boolean" },
        "stokta_var_mi": { "type": "boolean" },
        "tukendi_mi": { "type": "boolean" }
      }
    },
    "Siparis": {
      "title": "Siparis",
      "description": "Yemek siparişi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "durum": { "type": "string" },
        "toplam_tutar": { "type": "number" },
        "stok_dusuldu_mu": { "type": "boolean" },
        "stok_iade_edildi_mi": { "type": "boolean" }
      }
    },
    "CokluMenu": {
      "title": "CokluMenu",
      "description": "Sınırsız çeşit içeren çoklu ev menüsü / ziyafet paketi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mutfak_id": { "type": "string" },
        "baslik": { "type": "string" },
        "fiyat": { "type": "number" },
        "stokta_var_mi": { "type": "boolean" },
        "onay_durumu": { "type": "string" }
      }
    },
    "Kullanici": {
      "title": "Kullanici",
      "description": "Müşteri, ev mutfağı, kurye ve yönetici hesapları",
      "type": "object",
      "properties": {
        "kimlik": { "type": "string" },
        "ad_soyad": { "type": "string" },
        "telefon": { "type": "string" },
        "rol": { "type": "string" },
        "isletme_adi": { "type": "string" },
        "guvenlik_sorusu": { "type": "string" },
        "guvenlik_cevabi": { "type": "string" },
        "calisma_modeli": { "type": "string" },
        "ilce": { "type": "string" },
        "adres": { "type": "string" },
        "hijyen_belgesi_durumu": { "type": "string" },
        "esnaf_muafiyet_durumu": { "type": "string" },
        "onayli_mi": { "type": "boolean" },
        "onay_durumu": { "type": "string" },
        "askida_mi": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/kullanicilar/{kullaniciId}": {
      "schema": "Kullanici",
      "description": "Sistem kullanıcı hesapları"
    },
    "/mutfaklar/{mutfakId}": {
      "schema": "Mutfak",
      "description": "Kayıtlı ev mutfakları"
    },
    "/yemekler/{yemekId}": {
      "schema": "Yemek",
      "description": "Mutfak yemekleri"
    },
    "/coklu_menuler/{menuId}": {
      "schema": "CokluMenu",
      "description": "Çoklu çeşit ev menüleri"
    },
    "/siparisler/{siparisId}": {
      "schema": "Siparis",
      "description": "Mutfak ve müşteri siparişleri"
    },
    "/tamamlanan_siparisler/{siparisId}": {
      "schema": "Siparis",
      "description": "Tamamlanan siparişler"
    }
  }
}
